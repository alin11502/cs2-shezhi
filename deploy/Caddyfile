{
	# 证书申请通知邮箱，部署前改成你自己的
	email admin@example.com
}

# 站点域名，部署前替换；本地调试可用 :8080 代替
{$SITE_DOMAIN:example.com} {
	encode zstd gzip

	# PocketBase API（含 /api/files 文件访问）
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	# PocketBase 自带管理后台
	# 安全建议：正式环境用 firewall 或下面的 remote_ip 限制只允许你的 IP 访问
	handle /_/* {
		reverse_proxy 127.0.0.1:8090
	}

	# 其余全部走 Astro 静态产物
	handle {
		root * /var/www/cs2-shezhi/site

		# 带 hash 的构建资源可长期缓存
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"

		try_files {path} {path}/ /404.html
		file_server
	}

	log {
		output file /var/log/caddy/cs2-shezhi.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
