# cs2cx CLI 用。复制为 cli/.env 后填写，.env 已被 gitignore。

# PocketBase 地址：本地开发 http://127.0.0.1:8090，线上 https://你的域名
PB_URL=http://127.0.0.1:8090

# 管理员凭证。两种方式，二选一：
# 1) 直接填 superuser 的邮箱密码，CLI 会自己换 token（本地开发方便）
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
# 2) 填已签发的 token（CI/脚本场景，避免明文密码）
PB_TOKEN=

# demo 文件目录，cs2cx scan/extract 的默认路径
DEMO_DIR=

# 导出 JSON 的输出目录
OUT_DIR=./out
