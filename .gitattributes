# 默认按 git 的判断规范化行尾
* text=auto

# 这些要在 Linux VPS 上执行，必须是 LF。
# Windows 开发机若设了 core.autocrlf=true，没有这条会被转成 CRLF，
# 运行时报 "bad interpreter: No such file or directory"。
*.sh text eol=lf
Caddyfile text eol=lf
*.service text eol=lf

# 二进制，绝不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff2 binary
*.dem binary
*.zip binary
